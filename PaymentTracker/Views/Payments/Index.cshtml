@model IEnumerable<Payment>

@{
    ViewData["Title"] = "Payments";
}

<h2>Payments</h2>


<form asp-action="DeleteSelected" method="post">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    <input type="checkbox" 
                        onclick="document.querySelectorAll('input[name=selectedIds]').forEach(c => c.checked = this.checked)" 
                    />
                </th>
                <th>Titulo</th>
                <th>Description</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Date</th>
                <th>Edit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" name="selectedIds" value="@p.Id" />
                    </td>
                    <td>@p.Title</td>
                    <td>@p.Description</td>
                    <td>@p.Category</td>
                    <td>@p.Amount</td>
                    <td>@p.Date.ToShortDateString()</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@p.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="flex-row">
        <button type="submit" class="btn btn-danger">
            Delete Selected
         </button>
        <a asp-action="Create" class="btn btn-primary">
            Add Payment
        </a>
    </div>
</form>
